<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDedupe.App.ViewModels"
        x:Class="VideoDedupe.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440"
        Height="880"
        MinWidth="960"
        MinHeight="720"
        Title="VideoDedupe">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>
  <Window.Resources>
    <!-- ===== Accent palette (Purple) ===== -->
    <Color x:Key="AccentColor">#8B5CF6</Color>
    <!-- violet -->
    <Color x:Key="AccentColor2">#6366F1</Color>
    <!-- indigo -->
    <Color x:Key="AccentGlow">#A78BFA</Color>

    <!-- ===== Surfaces (Dark) ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0B12"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121225"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#17173A"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#2B2B55"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentBrush2" Color="{DynamicResource AccentColor2}"/>

    <SolidColorBrush x:Key="TextBrush" Color="#F2F2FF"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#B9B9D6"/>
  </Window.Resources>

  <Window.Styles>
    <!-- Window background -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    </Style>

    <!-- Default text -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Panels -->
    <Style Selector="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Buttons (accent) -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Secondary buttons (optional): add class 'secondary' -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- TextBox styling -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <!-- ComboBox / ListBox basic surfaces -->
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*"
        Margin="14"
        RowSpacing="12">

    <!-- ===================== TOP BAR ===================== -->
    <Border Grid.Row="0" CornerRadius="12" Padding="12" Background="{DynamicResource SurfaceBrush}">
      <!-- Keep the progress/status column stable while long file names update. -->
      <Grid ColumnDefinitions="*,500"
            ColumnSpacing="14">

        <!-- Left: DB + Actions -->
        <StackPanel Grid.Column="0" Spacing="10">

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Database"/>
            <TextBox Grid.Column="1"
                     Text="{Binding State.DbPath}"/>
            <Button Grid.Column="2"
                    Content="Pick DB…"
                    Command="{Binding PickDbCommand}"
                    IsEnabled="{Binding !State.IsBusy}"/>
          </Grid>

          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <Button Content="Load Roots"
                    Command="{Binding Library.LoadRootsCommand}"
                    IsEnabled="{Binding !State.IsBusy}"/>
            <Button Content="Load Groups"
                    Command="{Binding Groups.LoadGroupsCommand}"
                    IsEnabled="{Binding !State.IsBusy}"/>

            <Separator Width="10"/>

            <Button Content="Scan Index"
                    Command="{Binding Library.RunScanIndexCommand}"
                    IsEnabled="{Binding !State.IsBusy}"/>
            <Button Content="Cancel Index"
                    Command="{Binding Library.CancelScanIndexCommand}"
                    IsVisible="{Binding Library.IsIndexing}"/>

            <Separator Width="10"/>

            <Button Content="Dupe Build"
                    Command="{Binding Build.RunCommand}"
                    IsEnabled="{Binding !State.IsBusy}"/>
            <Button Content="Cancel Build"
                    Command="{Binding Build.CancelCommand}"
                    IsVisible="{Binding Build.IsBuilding}"/>
          </WrapPanel>

        </StackPanel>

        <!-- Right: Progress + Status -->
        <StackPanel Grid.Column="1" Spacing="10">

          <!-- Index progress -->
          <Border CornerRadius="10" Padding="10" IsVisible="{Binding Library.IsIndexing}">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Indexing"/>
              <ProgressBar Minimum="0" Maximum="1" Height="10" Value="{Binding Library.IndexPercent}"/>
              <TextBlock Opacity="0.85">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0}/{1}  ok={2} fail={3}">
                    <Binding Path="Library.IndexProcessed"/>
                    <Binding Path="Library.IndexDiscovered"/>
                    <Binding Path="Library.IndexOk"/>
                    <Binding Path="Library.IndexFail"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Library.IndexCurrent}"/>
            </StackPanel>
          </Border>

          <!-- Dupe progress -->
          <Border CornerRadius="10" Padding="10" IsVisible="{Binding Build.IsBuilding}">
            <StackPanel Spacing="6">
              <TextBlock FontWeight="SemiBold" Text="Dupe Build"/>
              <ProgressBar Minimum="0" Maximum="1" Height="10" Value="{Binding Build.Percent}"/>
              <TextBlock Opacity="0.85">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} - overall: {1}/{2}">
                    <Binding Path="Build.Phase"/>
                    <Binding Path="Build.Done"/>
                    <Binding Path="Build.Total"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Opacity="0.85" Text="{Binding Build.Eta}"/>
              <TextBlock Opacity="0.75"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Build.Current}"/>
            </StackPanel>
          </Border>

          <!-- Status -->
          <Border CornerRadius="10" Padding="10">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock FontWeight="SemiBold" Text="Status"/>
                <Button Grid.Column="1"
                        Classes="secondary"
                        Padding="8,2"
                        Content="Cancel clean-up"
                        Command="{Binding Groups.CancelCleanUpCommand}"
                        IsVisible="{Binding Groups.IsCleaning}"/>
              </Grid>
              <TextBlock TextWrapping="Wrap"
                         Opacity="0.85"
                         Text="{Binding State.Status}"/>
            </StackPanel>
          </Border>

        </StackPanel>

      </Grid>
    </Border>

    <!-- ===================== MAIN CONTENT ===================== -->
    <Grid Grid.Row="1"
          ColumnDefinitions="*,8,2*"
          ColumnSpacing="12">

      <!--  LEFT PANE -->
      <Border Grid.Column="0" CornerRadius="12" Padding="12" Background="{DynamicResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">

          <TextBlock Grid.Row="0"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="Workspace"/>

          <TabControl Grid.Row="1">

            <!-- ========== ROOTS TAB ========== -->
            <TabItem Header="Roots">
              <Grid RowDefinitions="Auto,Auto,*"
                    RowSpacing="10"
                    Margin="2">

                <WrapPanel Grid.Row="0" ItemSpacing="10" LineSpacing="8">
                  <Button Content="Add Root…"
                          Command="{Binding Library.AddRootCommand}"
                          IsEnabled="{Binding !State.IsBusy}"/>
                  <Button Content="Remove Selected"
                          Command="{Binding Library.RemoveSelectedRootCommand}"
                          IsEnabled="{Binding Library.SelectedRoot, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  <Button Content="Save Enabled"
                          Command="{Binding Library.SaveRootEnabledCommand}"
                          IsEnabled="{Binding !State.IsBusy}"/>
                  <Button Content="Save Options"
                          Command="{Binding Library.SaveRootOptionsCommand}"
                          IsEnabled="{Binding Library.SelectedRoot, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </WrapPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Grid.Column="0"
                           PlaceholderText="Paste folder path (e.g. D:\Videos)"
                           Text="{Binding Library.NewRootPath}"/>
                  <Button Grid.Column="1"
                          Content="Add Path"
                          Command="{Binding Library.AddRootFromTextCommand}"
                          IsEnabled="{Binding !State.IsBusy}"/>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                  <Border Grid.Column="0" CornerRadius="10" Padding="10" Background="{DynamicResource Surface2Brush}">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Roots"/>
                      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Library.Roots}"
                                 SelectedItem="{Binding Library.SelectedRoot}">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RootVm">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsEnabled}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Path}"
                                           TextWrapping="Wrap"/>
                              </Grid>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </ScrollViewer>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1" CornerRadius="10" Padding="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="10">
                        <TextBlock FontWeight="SemiBold" Text="Selected root"/>
                        <TextBlock Opacity="0.85"
                                   TextWrapping="Wrap"
                                   Text="{Binding Library.SelectedRoot.Path}"/>

                        <CheckBox Content="Include subfolders"
                                  IsChecked="{Binding Library.SelectedRoot.IncludeSubdirs}"/>

                        <TextBlock Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Text="Exclude (MVP): semicolon separated tokens. Example: temp;cache;whatsapp"/>

                        <TextBox TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="90"
                                 Text="{Binding Library.SelectedRoot.ExcludeText}"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                </Grid>
              </Grid>
            </TabItem>

            <!-- ========== GROUPS TAB ========== -->
            <TabItem Header="Groups">
              <Grid RowDefinitions="Auto,Auto,Auto,*"
                    RowSpacing="10"
                    Margin="2">

                <!-- Filter row -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBox Grid.Column="0"
                           PlaceholderText="Filter groups by path contains…"
                           Text="{Binding Groups.Filter}"/>
                  <ComboBox Grid.Column="1"
                            Width="190"
                            ItemsSource="{Binding Groups.SortOptions}"
                            SelectedItem="{Binding Groups.Sort}"/>
                </Grid>

                <!-- Summary + clean-up -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center"
                             Opacity="0.85"
                             TextWrapping="Wrap"
                             Text="{Binding Groups.Summary}"/>
                  <Button Grid.Column="1"
                          Content="Clean up all groups…"
                          ToolTip.Tip="Keep the best copy of every group and move the others to the quarantine folder. Shows the full list first."
                          Command="{Binding Groups.CleanUpAllCommand}"
                          IsEnabled="{Binding !State.IsBusy}"/>
                </Grid>

                <!-- Options expander -->
                <Expander Grid.Row="2"
                          Header="Options"
                          IsExpanded="False">
                  <Border CornerRadius="10" Padding="10" Margin="0,8,0,0">
                    <StackPanel Spacing="10">

                      <CheckBox Content="Clear existing groups"
                                IsChecked="{Binding Build.ClearExisting}"/>

                      <CheckBox Content="Find mirrored copies"
                                ToolTip.Tip="Also match videos that are flipped left to right."
                                IsChecked="{Binding Build.MatchMirrored}"/>

                      <CheckBox Content="Confirm close calls by the soundtrack"
                                ToolTip.Tip="When the picture comparison is borderline and the scene check does not confirm it, compare two minutes of audio."
                                IsChecked="{Binding Build.UseAudio}"/>

                      <!-- Tol -->
                      <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Tolerance (sec)"/>
                        <Slider Grid.Column="1"
                                Minimum="0.05"
                                Maximum="2.00"
                                Value="{Binding Build.TolSec}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="False"/>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Opacity="0.85"
                                   Text="{Binding Build.TolSec, StringFormat={}{0:F2}}"/>
                      </Grid>

                      <!-- Min items -->
                      <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Min items"/>
                        <Slider Grid.Column="1"
                                Minimum="2"
                                Maximum="10"
                                Value="{Binding Build.MinItemsDouble}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Opacity="0.85"
                                   Text="{Binding Build.MinItems}"/>
                      </Grid>

                      <!-- MaxAvgDist -->
                      <Grid ColumnDefinitions="Auto,* ,Auto" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Max avg dist"/>
                        <Slider Grid.Column="1"
                                Minimum="2"
                                Maximum="30"
                                Value="{Binding Build.MaxAvgDist}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"/>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Opacity="0.85"
                                   Text="{Binding Build.MaxAvgDist, StringFormat={}{0:F0}}"/>
                      </Grid>

                      <!-- Frames -->
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Frames (%)"/>
                        <TextBox Grid.Column="1"
                                 PlaceholderText="20,50,80"
                                 Text="{Binding Build.FramesCsv}"/>
                      </Grid>

                      <TextBlock Opacity="0.65"
                                 Text="Frames = comma separated percents (1..99). Example: 20,50,80"/>

                      <!-- Quarantine -->
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Quarantine folder"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding State.QuarantineRoot}"/>
                        <Button Grid.Column="2"
                                Classes="secondary"
                                Content="Browse…"
                                Command="{Binding PickQuarantineCommand}"/>
                      </Grid>
                    </StackPanel>
                  </Border>
                </Expander>

                <!-- Groups list -->
                <Border Grid.Row="3" CornerRadius="10" Padding="10" Background="{DynamicResource Surface2Brush}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Groups.FilteredGroups}"
                             SelectedItem="{Binding Groups.SelectedGroup}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupVm">
                          <Border CornerRadius="10"
                                  Padding="10"
                                  Margin="0,0,0,8">
                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Title}"/>
                                <TextBlock Grid.Column="1"
                                           Opacity="0.85"
                                           Text="{Binding ReclaimableText}"/>
                              </Grid>
                              <TextBlock Opacity="0.75"
                                         TextTrimming="CharacterEllipsis"
                                         Text="{Binding BestFileName, StringFormat=keep: {0}}"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </Border>

              </Grid>
            </TabItem>

          </TabControl>
        </Grid>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

      <!-- RIGHT PANE -->
      <Border Grid.Column="2" CornerRadius="12" Padding="12" Background="{DynamicResource SurfaceBrush}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="10">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="6">
              <TextBlock FontSize="18"
                         FontWeight="SemiBold"
                         Text="{Binding Groups.SelectedGroup.Title}"/>
              <TextBlock Opacity="0.75"
                         Text="Tip: Double-click a member to open. Right-click for menu."/>
            </StackPanel>
            <WrapPanel Grid.Column="1"
                       ItemSpacing="10"
                       VerticalAlignment="Top"
                       IsVisible="{Binding Groups.SelectedGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button Content="Keep best, quarantine others"
                      ToolTip.Tip="Moves every file except the BEST one (or the files marked as keep) to the quarantine folder. Asks first."
                      Command="{Binding Groups.CleanUpGroupCommand}"
                      CommandParameter="{Binding Groups.SelectedGroup}"
                      IsEnabled="{Binding !State.IsBusy}"/>
              <Button Classes="secondary"
                      Content="Not duplicates"
                      ToolTip.Tip="These files are different videos. Removes the group; later builds will not group them again."
                      Command="{Binding Groups.GroupNotDuplicateCommand}"
                      CommandParameter="{Binding Groups.SelectedGroup}"
                      IsEnabled="{Binding !State.IsBusy}"/>
            </WrapPanel>
          </Grid>

          <Border Grid.Row="1" CornerRadius="10" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Groups.SelectedGroup.Members}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemberVm">
                    <Border CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,12"
                            DoubleTapped="Member_DoubleTapped">

                      <Border.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open"
                                    Command="{Binding Owner.OpenFileCommand}"
                                    CommandParameter="{Binding .}" />
                          <MenuItem Header="Show in Explorer"
                                    Command="{Binding Owner.ShowInExplorerCommand}"
                                    CommandParameter="{Binding .}" />
                          <MenuItem Header="Copy Path"
                                    Command="{Binding Owner.CopyPathCommand}"
                                    CommandParameter="{Binding .}" />
                          <Separator/>
                          <MenuItem Header="Keep this file"
                                    Command="{Binding Owner.MarkKeepCommand}"
                                    CommandParameter="{Binding .}" />
                          <MenuItem Header="Move to quarantine"
                                    Command="{Binding Owner.QuarantineCommand}"
                                    CommandParameter="{Binding .}" />
                          <MenuItem Header="Not a duplicate"
                                    Command="{Binding Owner.NotDuplicateCommand}"
                                    CommandParameter="{Binding .}" />
                          <Separator/>
                          <MenuItem Header="Delete"
                                    Command="{Binding Owner.DeleteFileCommand}"
                                    CommandParameter="{Binding .}" />
                        </ContextMenu>
                      </Border.ContextMenu>

                      <StackPanel Spacing="10">

                        <StackPanel Spacing="2">
                          <TextBlock FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     Text="{Binding Path}" />
                          <WrapPanel ItemSpacing="12">
                            <TextBlock Text="{Binding BestText}"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       IsVisible="{Binding IsBest}"/>
                            <TextBlock Text="KEEP"
                                       FontWeight="Bold"
                                       Opacity="0.9"
                                       IsVisible="{Binding IsKept}"/>
                            <TextBlock Text="MISSING"
                                       FontWeight="Bold"
                                       Opacity="0.85"
                                       IsVisible="{Binding IsMissing}"/>
                          </WrapPanel>
                          <TextBlock Opacity="0.85"
                                     TextWrapping="Wrap"
                                     Text="{Binding MatchText}"/>
                        </StackPanel>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="240" Height="135" CornerRadius="10">
                              <Image Source="{Binding Thumb20}" Stretch="UniformToFill"/>
                            </Border>
                            <Border Width="240" Height="135" CornerRadius="10">
                              <Image Source="{Binding Thumb50}" Stretch="UniformToFill"/>
                            </Border>
                            <Border Width="240" Height="135" CornerRadius="10">
                              <Image Source="{Binding Thumb80}" Stretch="UniformToFill"/>
                            </Border>
                          </StackPanel>
                        </ScrollViewer>

                        <TextBlock Opacity="0.75"
                                   Text="Loading thumbnails…"
                                   IsVisible="{Binding ThumbsLoading}"/>

                        <WrapPanel ItemSpacing="18" LineSpacing="6">
                          <TextBlock Opacity="0.85" Text="{Binding ResolutionText}"/>
                          <TextBlock Opacity="0.85" Text="{Binding DurationText}"/>
                          <TextBlock Opacity="0.85" Text="{Binding SizeText}"/>
                          <TextBlock Opacity="0.85" Text="{Binding BitrateText}"/>
                          <TextBlock Opacity="0.85" Text="{Binding CodecText}"/>
                          <TextBlock Opacity="0.85" Text="{Binding ModifiedText}"/>
                        </WrapPanel>

                        <WrapPanel ItemSpacing="10" LineSpacing="8">
                          <Button Content="Open"
                                  Command="{Binding Owner.OpenFileCommand}"
                                  CommandParameter="{Binding .}"/>
                          <Button Content="Explorer"
                                  Classes="secondary"
                                  Command="{Binding Owner.ShowInExplorerCommand}"
                                  CommandParameter="{Binding .}"/>
                          <Button Content="Keep"
                                  Classes="secondary"
                                  Command="{Binding Owner.MarkKeepCommand}"
                                  CommandParameter="{Binding .}"/>
                          <Button Content="Quarantine"
                                  Classes="secondary"
                                  Command="{Binding Owner.QuarantineCommand}"
                                  CommandParameter="{Binding .}"/>
                          <Button Content="Not a duplicate"
                                  Classes="secondary"
                                  Command="{Binding Owner.NotDuplicateCommand}"
                                  CommandParameter="{Binding .}"/>
                          <Button Content="Delete"
                                  Classes="secondary"
                                  Command="{Binding Owner.DeleteFileCommand}"
                                  CommandParameter="{Binding .}"/>
                        </WrapPanel>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

        </Grid>
      </Border>

    </Grid>
  </Grid>
</Window>
